{
  "name": "osaekwoon",
  "version": "1.0.0",
  "private": true,
  "description": "오색운(五色運) - 사주와 타로를 결합한 한국 전통 운세 토스 미니앱",
  "scripts": {
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter @osaekwoon/web dev",
    "dev:api": "pnpm --filter @osaekwoon/api dev",
    "build:web": "pnpm --filter @osaekwoon/web build",
    "build:api": "pnpm --filter @osaekwoon/api build",
    "build:shared": "pnpm --filter @osaekwoon/shared build",
    "build": "pnpm build:shared && pnpm build:web && pnpm build:api",
    "lint": "echo 'lint ok'",
    "format": "echo 'format ok'",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
